# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/

# Scratch / disposable
scratch/
.claude/
RUN_ERRORS.txt

# Outputs and Data Files
# Instead of ignoring the directories, ignore their contents so folder structures can be tracked
**/output/**/*
!**/output/**/
!**/output/**/.gitkeep

**/outputs/**/*
!**/outputs/**/
!**/outputs/**/.gitkeep

# Environment files
.env

# Data files to ignore (big files)
*.csv
*.parquet
*.xlsx

# Exclude requirement input Excel files from ignore list
!**/RequireInputData.xlsx

# Ensure .gitkeep files are never ignored
!**/.gitkeep



